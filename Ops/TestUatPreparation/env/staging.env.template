# =====================================================================
# staging.env.template — Delta لِما يجب تعديله في env-file الفعلي لبيئة TEST
# لاحقًا (المرحلة الثانية). لا أسرار هنا — placeholders فقط.
# دُمِج يدويًّا في TEST_ENV_FILE (chmod 600) وقت Cutover. لا يدخل Git بقيم حقيقية.
# مبني على تحليل Program.cs: التحويل إلى Staging لا يتطلّب تعديل شيفرة مصدرية،
# لكن بوّابتَي إقلاع صارمتان (JWT + CORS) تمنعان الإقلاع إن لم تُجهَّزا.
# =====================================================================

# --- البيئة (Development → Staging) ---
ASPNETCORE_ENVIRONMENT=Staging

# --- القاعدة الجديدة (من السكربت 02) ---
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=reporting_test_uat;Username=reporting_test_uat_app;Password=__SET_AT_RUNTIME__

# --- بوّابة إقلاع (1) JWT: يجب ≥32 محرفًا وبلا 'dev-only' (Program.cs) ---
Jwt__Key=__SET_STRONG_UNIQUE_32PLUS__
Jwt__Issuer=reporting-api
Jwt__Audience=reporting-spa

# --- بوّابة إقلاع (2) CORS: يجب غير فارغ، بلا wildcard/localhost (Program.cs) ---
Cors__AllowedOrigins__0=https://__TEST_DOMAIN__

# --- ملاحظة DataProtection/Cookie (لا مفاتيح — للتوثيق فقط) ---
# DataProtection persistence is not currently part of the reporting API runtime because authentication is JWT Bearer only.
# لذا حُذفت مفاتيح DataProtection__*/Cookie__* لأنها لا يقرؤها الـruntime الحالي (لا تُضِفها لتفعيلها بلا تعديل مصدر).

# --- Seed Admin (Staging ليس Production ⇒ يجب تعيينهما لمنع بذر admin افتراضي) ---
Seed__AdminEmail=admin@test.local
Seed__AdminPassword=__SET_AT_RUNTIME__

# --- القنوات الخارجية المقروءة فعليًّا من الـruntime — معطّلة في UAT ---
Email__Enabled=false
Reminders__Enabled=false
# ملاحظة: Scheduler__*/ExternalIntegrations__* لا يقرؤها الكود الحالي ⇒ حُذفت (لا فائدة من ضبطها).

# --- API / SignalR same-origin (نفس دومين TEST) ---
# الواجهة تُبنى بـ VITE_API_BASE_URL=https://__TEST_DOMAIN__/api ؛ SignalR على /hubs/notifications نفس الأصل.

# --- Rate limiting (اختياري رفعه في UAT) ---
# RateLimiting__AuthPermitLimit=1000
