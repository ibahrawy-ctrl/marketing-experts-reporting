# =====================================================================
# UAT TEST Preparation — config template (NO SECRETS IN GIT)
# Package: UAT-TEST-PREP-RC4  (G1 — Scripts & Cutover Package)
# =====================================================================
# نسخة هذا الملف إلى ملف حقيقي خارج Git وقت التنفيذ:
#     cp config.env.template /root/uat-prep/config.env
#     chmod 600 /root/uat-prep/config.env
# ثم عبّئ القيم الحقيقية هناك. لا تضع أي قيمة سرّية داخل هذا القالب أو في Git.
#
# كل السكربتات تعمل في وضع PLAN افتراضيًّا. الكتابة تتطلب: --apply + OPS_ALLOW_WRITE=1 + تأكيد تفاعلي.
# ---------------------------------------------------------------------

# --- الهوية والإصدار ---
RELEASE_ID="UAT-TEST-PREP-RC4"                 # معرّف الحزمة (يظهر في الـManifest)
EXPECTED_GIT_REF="ffb511906f0b523ebf59fbfa27a51be66189109a"   # develop@ffb5119 (مرجع تكافؤ Runtime)

# --- الخادم / SSH (يُستخدم فقط عند التنفيذ الفعلي في المرحلة الثانية) ---
OPS_SERVER_HOST="REPLACE_ME_root@host"          # مثال: root@187.127.72.232
OPS_SSH_KEY="REPLACE_ME_/path/to/key"           # مثال: ~/.ssh/academy_vps_ed25519
OPS_EXPECTED_HOSTNAME="REPLACE_ME_srvXXXXXX"    # اسم الخادم المتوقّع (حارس ضدّ خادم خاطئ)

# --- بيئة TEST/UAT (الوحيدة المسموح الكتابة عليها) ---
TEST_DOMAIN="REPLACE_ME_test.example.net"       # دومين TEST فقط (لا Production/RC)
TEST_SERVICE_NAME="REPLACE_ME_reporting-test"   # اسم خدمة systemd لبيئة TEST فقط
TEST_ENV_FILE="REPLACE_ME_/etc/reporting-test.env"   # env-file الفعلي لبيئة TEST
TEST_PUBLISH_DIR="REPLACE_ME_/opt/reporting-test/publish"
TEST_FRONTEND_DIST="REPLACE_ME_/opt/reporting-test/frontend/dist"
TEST_NGINX_CONF="REPLACE_ME_/etc/nginx/sites-available/reporting-test.conf"
TEST_API_LOCAL_URL="http://127.0.0.1:PORT"      # عنوان الـAPI الداخلي لبيئة TEST
TEST_UPLOADS_DIR="REPLACE_ME_/var/lib/reporting-test"  # مسار الملفات/المرفقات إن وُجد

# --- PostgreSQL ---
# ملاحظة مهمّة (Backup): سكربت 01-backup-test.sh لم يعد يفترض postgres superuser.
# بل يشتقّ اعتماد pg_dump/psql من سلسلة اتصال التطبيق نفسها (ConnectionStrings__Default)
# الموجودة داخل env-file المشار إليه بـ TEST_ENV_FILE (أدناه). يعمل بلا تغيير على
# TEST/RC/Production بتغيير env-file لكل بيئة فقط. لا كلمة سرّ postgres، لا .pgpass، لا sudo، لا peer.
# APP_CONN_ENV_KEY اختياري (الافتراض ConnectionStrings__Default) لو اختلف اسم المفتاح.
# PGHOST/PGPORT/PG_SUPERUSER أدناه تبقى فقط لسكربتات إنشاء القاعدة/الدور مستقبلًا (02+)، لا للـBackup.
APP_CONN_ENV_KEY="ConnectionStrings__Default"     # اسم مفتاح سلسلة الاتصال داخل env-file (لا يحوي سرًّا)
PGHOST="127.0.0.1"
PGPORT="5432"
PG_SUPERUSER="postgres"                          # لإنشاء القاعدة/الدور فقط (02+)؛ لا يُستخدَم في الـBackup — لا تخزّن كلمته هنا (peer/.pgpass)

# --- القواعد ---
CURRENT_TEST_DB="REPLACE_ME_reporting_test_rc"   # القاعدة الحالية = أرشيف مرجعي، لا تُعدَّل ولا تُحذف
NEW_UAT_DB="reporting_test_uat"                  # القاعدة الجديدة النظيفة (هدف الكتابة الوحيد)
NEW_UAT_ROLE="reporting_test_uat_app"            # دور التطبيق للقاعدة الجديدة

# --- المسارات المحلية (على الخادم) ---
BACKUP_ROOT="REPLACE_ME_/root/db-backups/uat-prep"   # جذر النسخ الاحتياطي
# DataProtection key ring اختياري وغير مُستخدَم: الـruntime يعتمد JWT Bearer فقط (لا DataProtection persistence).
# اتركه فارغًا (الافتراض) ⇒ يُسجَّل في الـManifest "not configured / not applicable" ولا يُنسَخ أي مسار.
# لا تضبطه إلا إذا فُعِّل DataProtection persistence مستقبلًا. غيابه ليس Blocker.
DATAPROTECTION_KEYPATH=""

# --- حراس أنماط محظورة (لا تُعدَّل إلا بموافقة) ---
# أي اسم قاعدة/خدمة/دومين يطابق هذا النمط يوقف كل السكربتات فورًا.
FORBIDDEN_NAME_REGEX="prod|production|reports\\.emarketingacademy\\.net|reporting_prod|reporting_rc|_rc_live|academy-api"

# --- أسرار وقت التنفيذ (تُمرَّر عبر البيئة فقط — لا تُكتب هنا) ---
